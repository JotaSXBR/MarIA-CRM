    "test:e2e": "vitest run test/server.e2e.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@maria/auth": "workspace:*",
    "@maria/channel-waha": "workspace:*",
    "@maria/database": "workspace:*",
    "@maria/messaging": "workspace:*",
    "fastify": "5.12.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.15.5"
  }
}
