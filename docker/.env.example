# Local development stack — copy to docker/.env and fill in real values.
# Never commit docker/.env; it is gitignored.

# PostgreSQL (maria_admin superuser for local migrations)
POSTGRES_PASSWORD=change-me-postgres

# Redis (WAHA apps/background jobs only — internal to the compose network)
REDIS_PASSWORD=change-me-redis

# WAHA HTTP API
# Image pin: devlikeapro/waha:<browser>-<version>; override to upgrade or
# switch to a waha-plus image on a licensed host.
# WAHA_IMAGE=devlikeapro/waha:latest-2026.8.2
WAHA_API_KEY=change-me-waha-api-key
WAHA_ENGINE=GOWS
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-dashboard
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=change-me-swagger

# Timezone for WAHA logs/schedule features
TZ=America/Sao_Paulo
