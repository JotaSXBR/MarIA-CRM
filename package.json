{
  "name": "maria-crm",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "fmt": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "fmt:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
    "lint": "oxlint --type-aware apps",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
