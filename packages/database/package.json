{
  "name": "@maria/database",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./test/utils/postgres.ts",
      "default": "./test/utils/postgres.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/database.test.ts",
    "test:integration": "vitest run test/rls.integration.test.ts test/migrate.integration.test.ts test/messaging.integration.test.ts test/ownership.integration.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fractional-indexing": "^4.0.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.15.5",
    "vitest": "5.0.0"
  }
}
